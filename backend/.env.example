# ============================================
# TecNM Assets Management — Backend
# ============================================
# Copiar como referencia. En desarrollo, los secretos JWT viven en user-secrets:
#   dotnet user-secrets set "Jwt:Secret" "<clave-larga-y-secreta>"
#   dotnet user-secrets set "Jwt:Issuer" "tecnm-inventario"
#   dotnet user-secrets set "Jwt:Audience" "tecnm-inventario-api"
#
# En contenedores/CI pueden usarse variables de entorno (formato __ o :).

# JWT
Jwt__Secret=
Jwt__Issuer=
Jwt__Audience=

# Base de datos (PostgreSQL en Docker, ver database/docker-compose.yml)
ConnectionStrings__Default=Host=localhost;Port=5433;Database=tecnm_inventario;Username=tecnm_dev;Password=

# Almacenamiento local de documentos
Storage__LocalPath=storage/documents

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
