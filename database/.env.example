# BD de DESARROLLO (database/docker-compose.yml, puerto 5433). Copia a database/.env (no se versiona).
# Producción usa database/.env.prod, que genera el CLI tecnm (ver env.prod.example).
POSTGRES_USER=tecnm_dev
POSTGRES_DB=tecnm_inventario
# Elige una contraseña; la misma va en la cadena de conexión de la API (user-secrets, ver README).
POSTGRES_PASSWORD=
