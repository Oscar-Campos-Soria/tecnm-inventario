# Copia a database/.env.prod (no se versiona). El CLI tecnm la genera con secretos aleatorios.
# IP o nombre con el que los usuarios entran (sin puerto).
PUBLIC_HOST=192.168.1.50
POSTGRES_USER=tecnm_prod
POSTGRES_DB=tecnm_inventario
# Contraseña larga y aleatoria (32+ caracteres).
POSTGRES_PASSWORD=
# Clave de firma JWT: 64+ caracteres aleatorios.
JWT_SECRET=
